# Bases de la comunidad: se ignora todo salvo el servidor y el cliente de PokeDash
bases/*
!bases/pokedashpota1.0/
!bases/pokedashpota1.0_client/

# Dentro de PokeDash: lo pesado, binarios y archivos generados
bases/pokedashpota1.0/data/world/*.otbm
# ...menos el mapa que usa el servidor (~83 MB; el tope de GitHub son 100 MB por archivo)
!bases/pokedashpota1.0/data/world/global_dash.otbm
bases/pokedashpota1.0/data/logs/
# sprites: el Tibia.spr pesa ~490 MB (GitHub no admite mas de 100 MB), se guarda aparte.
# El Tibia.dat (3 MB) si va en git: guarda que sprite usa cada objeto.
bases/pokedashpota1.0_client/data/things/*/*
!bases/pokedashpota1.0_client/data/things/*/Tibia.dat
bases/**/*.exe
bases/**/*.dll
# ...pero el ejecutable y las DLL del servidor SI van en git (son ~15 MB) para que nadie tenga que pedirlos aparte
!bases/pokedashpota1.0/pokedashpota_win64.exe
!bases/pokedashpota1.0/*.dll
# ...y tambien el programa del cliente y sus DLL (~13 MB)
!bases/pokedashpota1.0_client/pokedash_*.exe
!bases/pokedashpota1.0_client/*.dll
bases/**/*_linux64
bases/**/*.log
bases/**/*.bak
bases/**/.DS_Store

# copias locales de la base de datos
backups/
