// Barras en forma de pastilla (vida, ataques...). El relleno tambien es redondeado y suave:
// UIPillBar (corelib/ui/uipillbar.lua) estira una imagen de pastilla (hijo "fill") hasta el
// % y la tine con el color (setBackgroundColor); el texto va en el hijo "label", encima.
// Uso: un PillTrack (la guia oscura) y justo despues el PillBar con anchors.fill: prev.

PillTrack < UIWidget
  height: 18
  image-source: /images/statusbar/track
  image-border: 9
  phantom: true

PillBar < UIPillBar
  anchors.fill: prev
  fill-color: #2f9e44
  phantom: true

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/statusbar/pill_fill
    image-border: 9
    phantom: true

  Label
    id: label
    anchors.fill: parent
    text-align: center
    text-offset: 0 1
    font: poppins-semibold-11px
    color: #ffffff
    phantom: true

ThinTrack < UIWidget
  height: 6
  image-source: /images/statusbar/thin_track
  image-border: 3
  phantom: true

ThinBar < UIPillBar
  anchors.fill: prev
  fill-color: #3b82d9
  phantom: true

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/statusbar/thin_fill
    image-border: 3
    phantom: true

PillText < UILabel
  font: poppins-semibold-11px
  color: #c9d1dc
  text-auto-resize: true
  phantom: true

// dentro de las capsulas (Pokebar, Combate): ahora son iguales, se mantienen los nombres
RowPillBar < PillBar

RowThinBar < ThinBar
