// Barras de desplazamiento modernas: sin flechas, guia fina y tirador redondeado que se
// aclara con el raton encima y se pone azul al arrastrarlo. Siguen midiendo 13px de ancho
// (vertical) / alto (horizontal), asi que ninguna ventana cambia de medidas. Las flechas
// existen (las usa UIScrollBar) pero miden 0. Imagenes: UiSkin.RunModern (ui/scroll_*).

ScrollBarSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 13 17
  image-source: /images/ui/scroll_thumb_v
  image-border: 4
  $hover:
    image-source: /images/ui/scroll_thumb_v_hover
  $pressed:
    image-source: /images/ui/scroll_thumb_v_pressed
  $disabled:
    image-color: #ffffff00

ScrollBarSliderH < ScrollBarSlider
  image-source: /images/ui/scroll_thumb_h
  $hover:
    image-source: /images/ui/scroll_thumb_h_hover
  $pressed:
    image-source: /images/ui/scroll_thumb_h_pressed

ScrollBarValueLabel < Label
  id: valueLabel
  anchors.fill: parent
  color: white
  text-align: center

VerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 13
  height: 39
  image-source: /images/ui/scroll_track_v
  image-border: 4
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 13 0

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 13 0

  ScrollBarSlider

  ScrollBarValueLabel

HorizontalScrollBar < UIScrollBar
  orientation: horizontal
  height: 13
  width: 39
  image-source: /images/ui/scroll_track_h
  image-border: 4

  $disabled:
    color: #bbbbbb88

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 0 13

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 0 13

  ScrollBarSliderH

  ScrollBarValueLabel
