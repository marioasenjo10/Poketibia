TopButton < UIButton
  size: 38 38
  icon-color: #ffffffff
  background-color: alpha

  $hover !disabled:
    background-color: #ffffff1c

  $pressed:
    background-color: #ffffff30

  $on:
    background-color: #c6282850

  $disabled:
    icon-color: #ffffff44

TopToggleButton < UIButton
  size: 38 38
  icon-color: #ffffffff
  background-color: alpha

  $hover:
    background-color: #ffffff1c

  $on:
    background-color: #c6282850

TopMenuButtonsPanel < Panel
  layout:
    type: horizontalBox
    spacing: 6
    fit-children: true
  padding: 4 8

TopMenuPanel < Panel
  height: 46
  image-source: /images/ui/panel_top
  image-repeated: true
  focusable: false

TopMenuFrameCounterLabel < Label
  font: verdana-11px-rounded
  color: white
  margin-top: 4
  margin-left: 5

TopMenuPingLabel < Label
  font: verdana-11px-rounded
