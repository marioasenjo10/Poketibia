// fondo invisible en reposo; al pasar el raton, pulsar o tener la ventana abierta sale un brillo
// redondeado y el icono crece un poco (todas las propiedades tienen valor base para que se restauren)
TopButton < UIButton
  size: 38 38
  icon-size: 30 30
  icon-offset: 4 4
  icon-color: #ffffffff
  background-color: alpha
  image-source: /images/topmenu/hover
  image-color: #ffffff00

  $hover !disabled:
    image-color: #ffffffff
    icon-size: 34 34
    icon-offset: 2 2

  $on:
    image-source: /images/topmenu/on
    image-color: #ffffffff

  $pressed:
    image-source: /images/topmenu/pressed
    image-color: #ffffffff
    icon-size: 28 28
    icon-offset: 5 5

  $disabled:
    icon-color: #ffffff44

TopToggleButton < TopButton

TopMenuButtonsPanel < Panel
  layout:
    type: horizontalBox
    spacing: 6
    fit-children: true
  padding: 4 8

TopMenuPanel < Panel
  height: 46
  image-source: /images/topmenu/pill
  image-border: 16
  focusable: false

TopMenuFrameCounterLabel < Label
  font: verdana-11px-rounded
  color: white
  margin-top: 4
  margin-left: 5
  phantom: true

TopMenuPingLabel < Label
  font: verdana-11px-rounded
  phantom: true
