DexListRow < UIWidget
  height: 26
  focusable: true
  background-color: alpha

  $hover:
    background-color: #17253a

  $focus:
    background-color: #22406a

  UIWidget
    id: ball
    size: 14 14
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    image-source: /game_pokedex/images/pokeball
    phantom: true

  Label
    id: number
    anchors.left: ball.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 38
    font: poppins-semibold-11px
    color: #5d6f88
    phantom: true

  Label
    id: name
    anchors.left: number.right
    anchors.right: dot.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    margin-right: 6
    font: poppins-12px
    color: #8b9ab0
    phantom: true

  UIWidget
    id: dot
    size: 7 7
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    image-source: /game_pokedex/images/dot
    image-color: #33425a
    phantom: true

DexChip < Label
  height: 20
  image-source: /game_pokedex/images/chip
  image-border: 8
  font: poppins-semibold-11px
  color: #ffffff
  text-align: center
  phantom: true

DexTab < UIButton
  size: 120 32
  font: poppins-semibold-11px
  color: #7f93ad
  background-color: alpha
  focusable: false

  $hover:
    color: #ffffff
    background-color: #142135

  $on:
    color: #ffffff
    background-color: #17263c
    border-width-bottom: 2
    border-color-bottom: #3d8fe0

DexSection < Label
  height: 16
  margin-top: 4
  font: poppins-semibold-11px
  color: #8ea3bf

DexText < Label
  font: poppins-12px
  color: #c9d4e3
  text-wrap: true
  text-auto-resize: true

DexButton < UIButton
  height: 26
  image-source: /game_pokedex/images/card
  image-border: 8
  font: poppins-semibold-11px
  color: #dfe8f3
  focusable: false

  $hover:
    image-source: /game_pokedex/images/card_hover
    color: #ffffff

DexFlow < UIWidget
  height: 20
  phantom: true
  layout:
    type: grid
    cell-size: 96 20
    cell-spacing: 6
    flow: true

DexEvoGrid < UIWidget
  height: 116
  layout:
    type: grid
    cell-size: 126 116
    cell-spacing: 4
    flow: true

DexEvoCell < UIWidget
  size: 126 116

  UIWidget
    id: arrow
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    image-source: /game_pokedex/images/arrow
    phantom: true

  UIButton
    id: card
    size: 100 116
    anchors.right: parent.right
    anchors.top: parent.top
    image-source: /game_pokedex/images/card
    image-border: 8
    focusable: false

    $hover:
      image-source: /game_pokedex/images/card_hover

    $on:
      image-source: /game_pokedex/images/card_active

    UICreature
      id: creature
      size: 64 64
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      phantom: true

    UIWidget
      id: image
      size: 64 64
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      phantom: true

    Label
      id: name
      anchors.top: creature.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 4
      margin-right: 4
      text-align: center
      font: poppins-semibold-11px
      color: #ffffff
      phantom: true

    Label
      id: level
      anchors.top: name.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      text-align: center
      font: poppins-12px
      color: #8ea3bf
      phantom: true

DexStatGrid < UIWidget
  height: 40
  layout:
    type: grid
    cell-size: 144 40
    cell-spacing: 6
    flow: true

DexStat < UIWidget
  size: 144 40
  image-source: /game_pokedex/images/card
  image-border: 8

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 10
    font: poppins-12px
    color: #8ea3bf
    phantom: true

  Label
    id: value
    anchors.top: name.bottom
    anchors.left: name.left
    anchors.right: parent.right
    margin-top: 1
    font: poppins-semibold-11px
    color: #ffffff
    phantom: true

DexEffRow < UIWidget
  height: 42

  Label
    id: label
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 18
    font: poppins-semibold-11px
    phantom: true

  DexFlow
    id: chips
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: label.bottom
    margin-top: 4
    layout:
      type: grid
      cell-size: 90 20
      cell-spacing: 6
      flow: true

DexMoveRow < UIWidget
  height: 52
  image-source: /game_pokedex/images/card
  image-border: 8

  UIWidget
    id: slot
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    image-source: /game_pokemonmoves/images/slot
    image-border: 7
    phantom: true

    UIWidget
      id: icon
      size: 32 32
      anchors.centerIn: parent
      phantom: true

  Label
    id: cooldown
    anchors.right: slot.right
    anchors.bottom: slot.bottom
    font: verdana-11px-rounded
    color: #ffffff
    background-color: #000000b0
    text-auto-resize: true
    phantom: true

  Label
    id: name
    anchors.left: slot.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 7
    font: poppins-semibold-13px
    color: #ffffff
    text-auto-resize: true
    phantom: true

  DexChip
    id: kind
    anchors.left: name.right
    anchors.verticalCenter: name.verticalCenter
    margin-left: 8
    height: 16

  Label
    id: description
    anchors.left: name.left
    anchors.right: element.left
    anchors.top: name.bottom
    margin-top: 3
    margin-right: 8
    font: poppins-12px
    color: #8ea3bf
    phantom: true

  DexChip
    id: element
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10

DexLootGrid < UIWidget
  height: 56
  layout:
    type: grid
    cell-size: 292 58
    cell-spacing: 8
    flow: true

DexLootCard < UIWidget
  size: 292 58
  image-source: /game_pokedex/images/card
  image-border: 8

  Item
    id: item
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    virtual: true
    phantom: true

  Label
    id: name
    anchors.left: item.right
    anchors.right: chance.left
    anchors.top: parent.top
    margin-left: 10
    margin-top: 6
    font: poppins-semibold-13px
    color: #ffffff
    phantom: true

  Label
    id: count
    anchors.left: name.left
    anchors.right: name.right
    anchors.top: name.bottom
    margin-top: 1
    font: poppins-12px
    color: #8ea3bf
    phantom: true

  Label
    id: chance
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 10
    margin-top: 6
    width: 90
    text-align: right
    font: poppins-semibold-13px
    color: #7ee07e
    phantom: true

  Label
    id: rarity
    anchors.right: chance.right
    anchors.top: chance.bottom
    margin-top: 1
    width: 90
    text-align: right
    font: poppins-12px
    color: #8ea3bf
    phantom: true

  UIWidget
    id: barBack
    anchors.left: name.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 7
    height: 4
    background-color: #24334b
    phantom: true

    UIWidget
      id: bar
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 2
      background-color: #7ee07e
      phantom: true

DexScroll < ScrollablePanel
  anchors.top: tabLine.bottom
  anchors.bottom: parent.bottom
  anchors.left: headerCard.left
  anchors.right: headerCard.right
  margin-top: 10
  margin-bottom: 14
  margin-right: 16
  layout:
    type: verticalBox
    spacing: 8

DexScrollBar < VerticalScrollBar
  anchors.top: tabLine.bottom
  anchors.bottom: parent.bottom
  anchors.right: headerCard.right
  margin-top: 10
  margin-bottom: 14
  step: 24
  pixels-scroll: true

UIWindow
  id: pokedexWindow
  size: 900 600
  anchors.centerIn: parent
  image-source: /game_pokedex/images/panel
  image-border: 10
  @onEscape: modules.game_pokedex.hide()

  UIWidget
    id: titleIcon
    size: 22 22
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 12
    margin-left: 14
    image-source: /game_pokedex/images/pokeball_big
    phantom: true

  Label
    id: title
    anchors.left: titleIcon.right
    anchors.verticalCenter: titleIcon.verticalCenter
    margin-left: 8
    font: poppins-bold-16px
    color: #ffffff
    text: PokeDex
    text-auto-resize: true
    phantom: true

  Label
    id: caughtLabel
    anchors.left: title.right
    anchors.verticalCenter: titleIcon.verticalCenter
    margin-left: 14
    font: poppins-12px
    color: #8ea3bf
    text-auto-resize: true
    phantom: true

  UIWidget
    id: progressBack
    anchors.left: caughtLabel.right
    anchors.verticalCenter: titleIcon.verticalCenter
    margin-left: 10
    size: 180 6
    background-color: #1d2a3e
    phantom: true

    UIWidget
      id: progressFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background-color: #3d8fe0
      phantom: true

  UIButton
    id: closeButton
    size: 16 16
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 15
    margin-right: 16
    image-source: /game_pokemonmoves/images/close
    focusable: false
    @onClick: modules.game_pokedex.hide()

    $hover:
      image-source: /game_pokemonmoves/images/close_hover

  TextEdit
    id: searchEdit
    anchors.top: titleIcon.bottom
    anchors.left: parent.left
    margin-top: 12
    margin-left: 14
    width: 244
    height: 24
    font: poppins-12px

  Label
    id: searchHint
    anchors.fill: searchEdit
    text-offset: 6 4
    font: poppins-12px
    color: #6c7a8d
    text: Buscar por nombre o numero...
    phantom: true

  TextList
    id: dexList
    anchors.top: searchEdit.bottom
    anchors.bottom: parent.bottom
    anchors.left: searchEdit.left
    width: 232
    margin-top: 8
    margin-bottom: 14
    background-color: #0b1220
    border-width: 0
    focusable: false
    vertical-scrollbar: dexListScrollBar

  VerticalScrollBar
    id: dexListScrollBar
    anchors.top: dexList.top
    anchors.bottom: dexList.bottom
    anchors.left: dexList.right
    step: 26
    pixels-scroll: true

  UIWidget
    id: headerCard
    anchors.top: searchEdit.top
    anchors.left: dexListScrollBar.right
    anchors.right: parent.right
    margin-left: 14
    margin-right: 14
    height: 158
    image-source: /game_pokedex/images/card
    image-border: 8

    UIWidget
      id: gradient
      anchors.fill: parent
      margin: 1
      image-source: /game_pokedex/images/gradient
      image-color: #3d8fe0
      phantom: true

    UIWidget
      id: stripe
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-top: 8
      margin-bottom: 8
      width: 4
      background-color: #3d8fe0
      phantom: true

    UICreature
      id: headerCreature
      size: 128 128
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 18
      phantom: true

    UIWidget
      id: headerImage
      size: 128 128
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 18
      phantom: true

    Label
      id: bigNumber
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 16
      margin-bottom: 4
      font: poppins-bold-52px
      color: #ffffff1e
      text-auto-resize: true
      phantom: true

    Label
      id: nameLabel
      anchors.left: headerCreature.right
      anchors.top: parent.top
      margin-left: 16
      margin-top: 12
      font: poppins-bold-26px
      color: #ffffff
      text-auto-resize: true
      phantom: true

    DexChip
      id: type1
      anchors.left: nameLabel.left
      anchors.top: nameLabel.bottom
      margin-top: 6

    DexChip
      id: type2
      anchors.left: type1.right
      anchors.top: type1.top
      margin-left: 6

    DexChip
      id: levelChip
      anchors.left: type2.right
      anchors.top: type1.top
      margin-left: 6
      image-color: #2b3b55

    DexChip
      id: specialChip
      anchors.left: levelChip.right
      anchors.top: type1.top
      margin-left: 6

    Label
      id: worldLabel
      anchors.left: nameLabel.left
      anchors.right: parent.right
      anchors.top: type1.bottom
      margin-top: 10
      margin-right: 12
      font: poppins-12px
      color: #dfe8f3
      phantom: true

    Label
      id: catchLabel
      anchors.left: nameLabel.left
      anchors.right: parent.right
      anchors.top: worldLabel.bottom
      margin-top: 4
      margin-right: 12
      font: poppins-12px
      color: #a9b8cc
      phantom: true

    UIButton
      id: shinyButton
      size: 32 32
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 10
      image-source: /game_pokedex/images/shiny
      focusable: false
      @onClick: modules.game_pokedex.toggleShiny()

      $hover:
        image-source: /game_pokedex/images/shiny_hover

      $on:
        image-source: /game_pokedex/images/shiny_on

    UIButton
      id: mapButton
      size: 32 32
      anchors.top: shinyButton.top
      anchors.right: shinyButton.left
      margin-right: 6
      image-source: /game_pokedex/images/search
      focusable: false
      tooltip: Ver donde aparece en el mapa
      @onClick: modules.game_pokedex.showAllOnMap()

      $hover:
        image-source: /game_pokedex/images/search_hover

  DexTab
    id: tabInfo
    anchors.top: headerCard.bottom
    anchors.left: headerCard.left
    margin-top: 10
    text: Info
    @onClick: modules.game_pokedex.showTab('info')

  DexTab
    id: tabMoves
    anchors.top: tabInfo.top
    anchors.left: tabInfo.right
    text: Ataques
    @onClick: modules.game_pokedex.showTab('moves')

  DexTab
    id: tabLoot
    anchors.top: tabInfo.top
    anchors.left: tabMoves.right
    text: Botin
    @onClick: modules.game_pokedex.showTab('loot')

  UIWidget
    id: tabLine
    anchors.top: tabInfo.bottom
    anchors.left: headerCard.left
    anchors.right: headerCard.right
    height: 1
    background-color: #26354f
    phantom: true

  Label
    id: emptyLabel
    anchors.left: headerCard.left
    anchors.right: headerCard.right
    anchors.top: tabLine.bottom
    margin-top: 60
    text-align: center
    text-wrap: true
    text-auto-resize: true
    font: poppins-12px
    color: #6c7a8d
    text: Elige un pokemon de la lista o usa la pokedex (tecla E) sobre un pokemon.
    phantom: true

  DexScroll
    id: infoPanel
    vertical-scrollbar: infoScrollBar

  DexScrollBar
    id: infoScrollBar

  DexScroll
    id: movesPanel
    vertical-scrollbar: movesScrollBar

  DexScrollBar
    id: movesScrollBar

  DexScroll
    id: lootPanel
    vertical-scrollbar: lootScrollBar

  DexScrollBar
    id: lootScrollBar
