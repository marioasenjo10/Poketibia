ComboIcon < UIButton
  size: 40 40
  image-source: /game_pokemonmoves/images/slot
  image-border: 7
  focusable: false

  UIWidget
    id: icon
    size: 32 32
    anchors.centerIn: parent
    phantom: true

  Label
    id: number
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 2
    font: noto-bold-9px
    color: #ffd84a
    image-source: /game_pokemonmoves/images/keycap
    image-border: 3
    padding: 0 3 0 3
    text-auto-resize: true
    phantom: true

ComboSection < Label
  height: 15
  font: noto-bold-11px
  color: #c9d3e0
  anchors.left: parent.left
  margin-left: 14

ComboBoxPanel < UIWidget
  image-source: /game_pokemonmoves/images/box
  image-border: 8
  anchors.left: parent.left
  anchors.right: parent.right
  margin-left: 12
  margin-right: 12
  padding: 8
  layout:
    type: grid
    cell-size: 40 40
    cell-spacing: 6
    flow: true

ComboSmallButton < UIButton
  size: 84 24
  image-source: /game_pokemonmoves/images/button
  image-border: 6
  font: noto-bold-11px
  color: #e6edf6
  focusable: false

  $hover:
    image-source: /game_pokemonmoves/images/button_hover
    color: #ffffff

UIWindow
  id: smartComboWindow
  size: 420 360
  anchors.centerIn: parent
  image-source: /game_pokemonmoves/images/window
  image-border: 10
  @onEscape: modules.game_pokemonmoves.toggleComboWindow()

  UIWidget
    id: bolt
    size: 16 16
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 14
    image-source: /game_pokemonmoves/images/bolt
    phantom: true

  Label
    id: title
    anchors.left: bolt.right
    anchors.verticalCenter: bolt.verticalCenter
    margin-left: 6
    font: noto-bold-14px
    color: #ffffff
    text: Smart Combo
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    size: 16 16
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 14
    margin-right: 14
    image-source: /game_pokemonmoves/images/close
    focusable: false
    @onClick: modules.game_pokemonmoves.toggleComboWindow()

    $hover:
      image-source: /game_pokemonmoves/images/close_hover

  UIWidget
    id: topBox
    anchors.top: bolt.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    margin-left: 12
    margin-right: 12
    height: 100
    image-source: /game_pokemonmoves/images/box
    image-border: 8
    phantom: true

  UIWidget
    id: portrait
    size: 64 64
    anchors.top: topBox.top
    anchors.horizontalCenter: topBox.horizontalCenter
    margin-top: 8
    phantom: true

  UICreature
    id: portraitCreature
    size: 64 64
    anchors.top: topBox.top
    anchors.horizontalCenter: topBox.horizontalCenter
    margin-top: 8
    phantom: true

  Label
    id: pokemonLabel
    anchors.top: portrait.bottom
    anchors.left: topBox.left
    anchors.right: topBox.right
    margin-top: 4
    height: 15
    text-align: center
    font: noto-bold-11px
    color: #ffffff
    phantom: true

  ComboSection
    id: movesLabel
    anchors.top: topBox.bottom
    margin-top: 12
    width: 250
    text: Movimientos disponibles:

  ComboBoxPanel
    id: movesBox
    anchors.top: movesLabel.bottom
    margin-top: 6
    height: 56

  ComboSection
    id: sequenceLabel
    anchors.top: movesBox.bottom
    margin-top: 12
    width: 250
    text: Secuencia del Combo:

  Label
    id: countLabel
    anchors.top: sequenceLabel.top
    anchors.right: parent.right
    margin-right: 14
    width: 120
    height: 15
    text-align: right
    font: noto-11px
    color: #8a98ab

  ComboBoxPanel
    id: sequencePanel
    anchors.top: sequenceLabel.bottom
    margin-top: 6
    height: 56

  Label
    id: emptyLabel
    anchors.centerIn: sequencePanel
    width: 380
    height: 15
    text-align: center
    font: noto-11px
    color: #6c7a8d
    text: Haz clic en un movimiento para anadirlo
    phantom: true

  ComboSmallButton
    id: clearButton
    anchors.top: sequencePanel.bottom
    anchors.left: parent.left
    margin-top: 12
    margin-left: 12
    text: Limpiar
    @onClick: modules.game_pokemonmoves.clearCombo()

  ComboSmallButton
    id: runButton
    anchors.top: clearButton.top
    anchors.left: clearButton.right
    margin-left: 6
    text: Probar
    @onClick: modules.game_pokemonmoves.runCombo()

  Label
    id: hintLabel
    anchors.right: parent.right
    anchors.verticalCenter: clearButton.verticalCenter
    margin-right: 14
    width: 200
    height: 15
    text-align: right
    font: noto-11px
    color: #6c7a8d
