SpellButton < UIButton
  width: 32
  height: 32
  focusable: false
  image-color: white
  image-size: 32 32
  anchors.left: parent.left
  anchors.top: parent.top

  $!hover:
    image-border: 3
  $hover:
    image-border: 2
    image-color: #ffffff99
  $pressed:
    image-color: #999999
  $disabled:
    image-color: #ffffff66

SpellProgressSpell < UIProgressRect
  background: #585858AA
  percent: 100
  focusable: false
  font: verdana-11px-rounded
  color: green
  anchors.left: parent.left
  anchors.top: parent.top
  size: 32 32

ComboToggle < UIButton
  size: 32 32
  anchors.left: parent.left
  anchors.top: parent.top
  font: verdana-11px-rounded
  text: AUTO
  color: #bbbbbb
  background-color: #00000099
  border-width: 1
  border-color: #555555
  focusable: false

  $hover:
    border-color: #ffffff

ComboMoveButton < UIButton
  size: 32 32
  image-size: 32 32
  focusable: false
  font: verdana-11px-rounded
  color: #ffff00
  text-align: topLeft
  text-offset: 2 0

  $hover:
    image-color: #ffffff99

UIWindow
  focusable: false
  Panel
    id: mainWindow
    size: 70 70
    focusable: false
    opacity: 0.95
    image-source: /images/ui/window
    anchors.fill: parent