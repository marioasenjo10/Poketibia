// Pokebar: equipo con vida y ataques listos (ventana flotante, se arrastra desde la cabecera).
// Cada pokemon es una capsula: retrato en un circulo (con su numero 1-6, marca de "fuera" y
// estrella si es shiny), barra de vida y barra fina de ataques. Modo compacto: solo el retrato
// con una barrita de vida. El pokemon activo tambien sale en "Estado de combate".

PokePanelTitle < UILabel
  font: poppins-semibold-11px
  color: #e8eef7
  text-auto-resize: true
  anchors.top: parent.top
  anchors.left: parent.left
  phantom: true

PokeHeaderButton < UIButton
  size: 14 14
  image-color: #ffffffaa
  $hover:
    image-color: #ffffffff

PokeRow < UIWidget
  size: 228 52
  margin-top: 4
  image-source: /images/statusbar/row
  image-border: 26
  focusable: false

  $hover:
    image-source: /images/statusbar/row_hover

  $on:
    image-source: /images/statusbar/row_active

  UIWidget
    id: portraitBg
    size: 44 44
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    image-source: /images/statusbar/circle
    phantom: true

  UIWidget
    id: portrait
    size: 46 46
    anchors.centerIn: portraitBg
    image-smooth: true
    phantom: true

  // barrita de vida del modo compacto, sobre el borde de abajo del circulo
  ThinTrack
    id: miniTrack
    anchors.left: portraitBg.left
    anchors.right: portraitBg.right
    anchors.bottom: portraitBg.bottom
    margin-left: 4
    margin-right: 4
    margin-bottom: -3
    visible: false

  RowThinBar
    id: miniHealth
    fill-color: #2f9e44
    visible: false

  // numero del pokemon (el de "Sacar Pokemon N" y !p N)
  Label
    id: slotBadge
    anchors.left: portraitBg.left
    anchors.top: portraitBg.top
    margin-left: -3
    margin-top: -3
    image-source: /images/bottombar/keycap
    image-border: 5
    padding: 0 4 2 4
    text-auto-resize: true
    font: noto-bold-9px
    color: #e6edf7
    phantom: true

  UIWidget
    id: outBadge
    size: 14 14
    anchors.right: portraitBg.right
    anchors.top: portraitBg.top
    margin-right: -3
    margin-top: -2
    image-source: /images/statusbar/out
    phantom: true
    visible: false

  UIWidget
    id: shinyBadge
    size: 13 13
    anchors.right: portraitBg.right
    anchors.bottom: portraitBg.bottom
    margin-right: -3
    margin-bottom: -1
    image-source: /images/statusbar/star
    phantom: true
    visible: false

  PillTrack
    id: healthTrack
    anchors.top: parent.top
    anchors.left: portraitBg.right
    anchors.right: parent.right
    margin-top: 9
    margin-left: 8
    margin-right: 16

  RowPillBar
    id: health

  // ancho fijo: asi todas las barras de ataques acaban en el mismo sitio (4/4 y 10/10)
  PillText
    id: movesText
    width: 38
    text-auto-resize: false
    text-align: right
    anchors.right: healthTrack.right
    anchors.top: healthTrack.bottom
    margin-top: 3

  ThinTrack
    id: movesTrack
    anchors.left: healthTrack.left
    anchors.right: movesText.left
    anchors.top: healthTrack.bottom
    margin-top: 9
    margin-right: 6

  RowThinBar
    id: moves

// misma cabecera que las ventanas de la derecha (miniwindow: cabecera de 23px)
PokebarWindow < UIWindow
  id: pokebarWindow
  width: 240
  image-source: /images/ui/miniwindow
  image-border: 7
  image-border-top: 23
  padding: 26 6 6 6
  focusable: false

  PokePanelTitle
    id: title
    margin-top: -22
    margin-left: 4

  PokeHeaderButton
    id: layoutButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -21
    margin-right: 2
    image-source: /images/statusbar/compact
    !tooltip: 'Modo compacto'

  PokeHeaderButton
    id: lockButton
    anchors.top: parent.top
    anchors.right: layoutButton.left
    margin-top: -21
    margin-right: 6
    image-source: /images/statusbar/unlock
    !tooltip: 'Bloquear posici' .. string.char(243) .. 'n'

  Panel
    id: rows
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    layout:
      type: verticalBox
      fit-children: true
