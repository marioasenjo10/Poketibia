// casilla de la barra de abajo: el objeto real sigue debajo (para usarlo / arrastrarlo),
// pero lo tapa la casilla con el icono nuevo. El icono y la tecla los pone inventory.lua
BarCell < UIWidget
  size: 60 74

BarSlot < UIItem
  size: 52 52
  padding: 12
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter

  UIWidget
    id: icon
    anchors.fill: parent
    phantom: true
    image-source: /images/bottombar/cell
    image-border: 12

    UIWidget
      id: img
      size: 36 36
      anchors.centerIn: parent
      phantom: true

  Label
    id: key
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: -6
    margin-top: -6
    image-source: /images/bottombar/keycap
    image-border: 5
    padding: 0 4 3 4
    text-auto-resize: true
    font: noto-bold-9px
    color: #1b2230
    phantom: true
    visible: false

BarLabel < Label
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  height: 16
  font: poppins-semibold-11px
  color: #ffffff
  text-align: center
  phantom: true

// barra de objetos (pokedex, order, rope, rod, badges) abajo del mapa, encima del chat
UIWidget
  id: inventoryWindow
  anchors.bottom: parent.bottom
  anchors.horizontalCenter: parent.horizontalCenter
  margin-bottom: 4
  height: 94
  padding: 10 14
  image-source: /images/bottombar/bar
  image-border: 18
  layout:
    type: horizontalBox
    spacing: 6
    fit-children: true

  BarCell
    BarSlot
      id: slot12
      &position: {x=65535, y=12, z=0}
    BarLabel
      text: POKEDEX

  BarCell
    BarSlot
      id: slot11
      &position: {x=65535, y=11, z=0}
    BarLabel
      text: ORDER

  BarCell
    BarSlot
      id: slot9
      &position: {x=65535, y=9, z=0}
    BarLabel
      text: ROPE

  BarCell
    BarSlot
      id: slot2
      &position: {x=65535, y=2, z=0}
    BarLabel
      text: ROD

  BarCell
    BarSlot
      id: slot8
      &position: {x=65535, y=8, z=0}
    BarLabel
      text: BADGES

  BackSlot
    visible: false
  LegSlot
    visible: false
