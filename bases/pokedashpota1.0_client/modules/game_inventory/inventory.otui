  id: slot11
  image-source: /images/game/slots/right-hand
  &position: {x=65535, y=11, z=0}
  $on:
    image-source: /images/game/slots/right-hand-blessed

// casilla de la barra de abajo: el objeto real sigue debajo (para usarlo / arrastrarlo),
// pero se tapa con el icono nuevo
BarCell < UIWidget
  size: 58 58

BarSlotFrame < UIWidget
  id: icon
  anchors.fill: parent
  phantom: true
  background-color: #0e2546
  border-width: 1
  border-color: #3b82d6

BarSlotImage < UIWidget
  size: 32 32
  anchors.centerIn: parent
  phantom: true

BarLabel < Label
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  height: 14
  font: verdana-11px-rounded
  color: #ffffff
  text-align: center
  phantom: true

// barra de objetos (pokedex, order, rope, rod, badges) abajo del mapa, encima del chat
UIWidget
  id: inventoryWindow
  anchors.bottom: parent.bottom
  anchors.horizontalCenter: parent.horizontalCenter
  margin-bottom: 6
  height: 70
  padding: 6 8
  background-color: #0a1a33e6
  border-width: 2
  border-color: #2b8ce6
  layout:
    type: horizontalBox
    spacing: 6
    fit-children: true

  BarCell
    InfoSlot
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      BarSlotFrame
        BarSlotImage
          image-source: /images/bottombar/pokedex
    BarLabel
      text: POKEDEX

  BarCell
    OrderSlot
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      BarSlotFrame
        BarSlotImage
          image-source: /images/bottombar/order
    BarLabel
      text: ORDER

  BarCell
    FingerSlot
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      BarSlotFrame
        BarSlotImage
          image-source: /images/bottombar/rope
    BarLabel
      text: ROPE

  BarCell
    NeckSlot
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      BarSlotFrame
        BarSlotImage
          image-source: /images/bottombar/rod
    BarLabel
      text: ROD

  BarCell
    FeetSlot
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      BarSlotFrame
        BarSlotImage
          image-source: /images/bottombar/badges
    BarLabel
      text: BADGES

  BackSlot
    visible: false
  LegSlot
    visible: false
