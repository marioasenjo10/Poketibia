// Ventana de mensaje del servidor (enfermera, NPCs...) con el estilo moderno: texto en
// Poppins, botones redondeados (el de Enter en azul) y sin el separador de Tibia.

ChoiceListLabel < Label
  font: poppins-semibold-11px
  color: #c9d1dc
  background-color: alpha
  text-offset: 6 2
  height: 22
  focusable: true

  $focus:
    background-color: #2c68b655
    color: #ffffff

ChoiceList < TextList
  id: choiceList
  vertical-scrollbar: choiceScrollBar
  anchors.fill: parent
  anchors.top: prev.bottom
  anchors.bottom: next.top
  margin-top: 4
  margin-bottom: 10
  focusable: false
  visible: false

ChoiceScrollBar < VerticalScrollBar
  id: choiceScrollBar
  anchors.top: choiceList.top
  anchors.bottom: choiceList.bottom
  anchors.right: choiceList.right
  step: 14
  pixels-scroll: true
  visible: false

ModalButton < UIButton
  height: 30
  padding: 0 22
  margin-left: 8
  text-auto-resize: true
  font: poppins-semibold-11px
  color: #e8eef7
  image-source: /images/shop/secondary
  image-border: 9

  $hover:
    image-source: /images/shop/secondary_hover

// el boton que se activa con Enter
ModalPrimaryButton < ModalButton
  color: #ffffff
  image-source: /images/shop/primary

  $hover:
    image-source: /images/shop/primary_hover

  $pressed:
    image-source: /images/shop/primary_pressed

ModalDialog < MainWindow
  id: modalDialog
  size: 300 118
  &minimumWidth: 260
  &maximumWidth: 600
  &minimumChoices: 4
  &maximumChoices: 10

  Label
    id: messageLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    text-align: left
    text-auto-resize: true
    text-wrap: true
    font: poppins-12px
    color: #d6dde8

  ChoiceList

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    visible: false

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    layout: horizontalBox
      align-right: true

  ChoiceScrollBar
